# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Type checking / linting
.mypy_cache/
.ruff_cache/
.dmypy.json

# Generated eval datasets (seeded — reproducible via `make dataset`)
data/eval/*.jsonl
data/eval/*.parquet

# Benchmark outputs (reproducible via `make bench`)
bench/out/
*.png
!docs/assets/*.png

# One-command demo output (reproducible via `scripts/demo.ps1`)
demo-output/

# Raw provider payloads (may contain PII)
data/raw/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# AI coding-assistant local config. .mcp.json used to be tracked as "shared
# project config"; it is tooling, not project setup, and it carried a Supabase
# project ref in its URL, so it is ignored now.
.claude/
.mcp.json
