# =============================================================================
# Adaptive Revenue Intelligence Engine — environment template
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================
# NOTE: M0 (the benchmark that proves the thesis) requires NONE of these.
# `make bench` runs fully offline with zero credentials. These are for M1.
# =============================================================================

# --- Database (Supabase) -----------------------------------------------------
# Use the POOLED connection string for workers (many short-lived connections).
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct (session) connection — used ONLY for running migrations.
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers -----------------------------------------------------------
# M1 Step 10. Used for ONE narrow task: buying-signal extraction from free
# text (arie.llm) — never a general "call an LLM" facility. Leave
# DEEPSEEK_API_KEY blank and everything still works: arie.llm.baseline (the
# deterministic comparison point) needs no key, arie.jobs.worker has no
# handler that calls arie.llm at all yet, and bench/llm_signal_eval.py
# reports the baseline only and exits 0 — nothing in CI or make test needs
# this key set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (cheap tier) only — never escalated to deepseek-reasoner.
# Changing this is a real methodology change, not a knob to tune per lead.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
# Total attempts including the first. A malformed response is retried with
# the identical request (stateless — no multi-turn self-correction), not a
# reasoning loop.
DEEPSEEK_MAX_ATTEMPTS=3

# Optional stronger tier for the escalation path of the model cascade.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Enrichment providers ----------------------------------------------------
# PROVIDER_MODE=simulated (default) replays the frozen eval corpus — no key
# needed, no real spend possible, and only corpus identities can be enriched.
# PROVIDER_MODE=live (post-M1 P5) enriches ANY ingested lead through the one
# real adapter below. Explicit opt-in only: build_handlers() raises
# AbstractCompanyConfigurationError at worker startup if this is set without
# the key configured — never a silent fallback to the simulator.
PROVIDER_MODE=simulated

# Abstract API — Company Enrichment (arie.providers.live_abstract). Free tier:
# 100 requests/month, no card required. https://docs.abstractapi.com/api/company-enrichment
ABSTRACT_COMPANY_API_KEY=
ABSTRACT_COMPANY_BASE_URL=https://companyenrichment.abstractapi.com/v2/
ABSTRACT_COMPANY_TIMEOUT_SECONDS=10
# An ESTIMATED unit cost (Standard plan list price / requests-per-month at
# time of writing), not a per-call price the provider reports — see
# LiveProviderConfig.cost_usd_per_call's own docstring.
ABSTRACT_COMPANY_COST_USD_PER_CALL=0.00165

# Deferred — no adapter written; these are unused placeholders.
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- Shadow mode (post-M1 P5) ------------------------------------------------
# Not a server-wide env var on purpose — shadow-ness is per-lead, set at
# ingestion via POST /leads {"mode": "shadow"} (default "normal"), so ARIE can
# sit beside an existing production workflow lead-by-lead rather than an
# all-or-nothing switch. See README's "Shadow mode" section.

# --- Policy configuration ----------------------------------------------------
# Hard per-lead spend ceiling (defense in depth, independent of the EVoI math).
LEAD_BUDGET_USD_CAP=1.50
# Target error rate for autonomous decisions; drives conformal threshold selection.
TARGET_AUTONOMOUS_ERROR_RATE=0.10
# Latency penalty weight in the EVoI formula (USD per second).
LATENCY_PENALTY_USD_PER_SEC=0.01

# --- Observability -----------------------------------------------------------
# Setting an OTLP endpoint IS what enables tracing — there is deliberately no
# separate on/off flag (two switches for one behaviour is two things to get out
# of sync). Left blank, the API and worker create no spans at all rather than
# building them and throwing them away. Point it at a collector's HTTP receiver,
# e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arie
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SEC=2
WORKER_MAX_ATTEMPTS=4
# How long a claimed job stays locked before another worker may reclaim it.
WORKER_LEASE_SECONDS=300
